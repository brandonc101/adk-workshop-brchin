# Copy this file to `.env` (in the same weather_agent/ directory) and fill in
# your values. The real `.env` is gitignored so secrets are never committed.

# --- Gemini via Vertex AI (default, no API key needed) ---
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=qwiklabs-gcp-02-362d4b03fa92
GOOGLE_CLOUD_LOCATION=us-central1

# --- Google Maps Geocoding API key (required by geocode_place) ---
GOOGLE_MAPS_API_KEY=REPLACE_WITH_YOUR_MAPS_API_KEY

# --- Model selection: gemini (default) | claude | gpt ---
MODEL_BACKEND=gemini
GEMINI_MODEL=gemini-2.5-flash

# --- Third-party model options (set MODEL_BACKEND=claude or gpt to use) ---
#
# Claude via Vertex AI (no separate key; uses your GCP project + gcloud creds).
# Enable the model first in Vertex AI Model Garden, then set:
# CLAUDE_MODEL=vertex_ai/claude-sonnet-4-5
# CLAUDE_LOCATION=us-east5
#
# Claude via the Anthropic API (needs a paid key):
# CLAUDE_MODEL=anthropic/claude-opus-4-8
# ANTHROPIC_API_KEY=sk-ant-...
#
# OpenAI GPT via the OpenAI API (needs a paid key):
# OPENAI_MODEL=openai/gpt-4o
# OPENAI_API_KEY=sk-...
